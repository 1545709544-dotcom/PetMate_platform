# ============================================
# PetMate 后端环境变量模板
# ============================================
# 复制为 `.env` 并填入真实值。`.env` 已在 .gitignore 中，
# 本文件可放心提交到仓库作为模板。
#
# 重要：所有 *_KEY / *_SECRET 都必须从环境变量注入，禁止硬编码到
# application.yml。所有 *_KEY 字段在 application.yml 中均使用
# ${ENV_VAR:dev-default} 形式带默认值，开发期不设也能跑。
# ============================================

# ===== 智谱 GLM API Key（用于 AI 问诊真实大模型）=====
# 注册：https://open.bigmodel.cn/
ZHIPU_API_KEY=

# ===== JWT 签名密钥（必须 >= 32 字节，建议 48 字节）=====
# 生产环境必须设置，禁止沿用默认值。
# 生成命令：
#   Linux/macOS : openssl rand -base64 48
#   Windows     : [System.Convert]::ToBase64String((1..48|%{Get-Random -Max 256})  -join '')
PETMATE_JWT_SECRET=

# ===== 支付宝当面付（电脑网站支付 page.pay / 当面付扫码 precreate）=====
# 沙箱申请：https://open.alipay.com/develop/sandbox/account
# 以下为必填项，未配置时 ALIPAY_ENABLED 必须保持 false
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=https://your-domain.com/api/v1/pay/alipay/notify
ALIPAY_RETURN_URL=http://localhost:5173/pay
# ====== 可选：是否跳过 TLS 证书校验（仅 sandbox 应急用） ======
# true  = 跳过证书与 hostname 校验（仅 sandbox 临时用）
# false = 走 JDK 默认信任（生产必须保持 false）
ALIPAY_INSECURE=false