<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.petmate</groupId>
  <artifactId>petmate-backend</artifactId>
  <version>1.0.0</version>
  <name>petmate-backend</name>
  <description>PetMate 智能宠物管家后端 — Spring Boot 3 + JDK 21 + MySQL 8</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- ===== 测试相关版本 ===== -->
    <testcontainers.version>1.20.4</testcontainers.version>
    <wiremock.version>3.9.2</wiremock.version>
    <jacoco.version>0.8.12</jacoco.version>

    <!--
      测试报告统一输出目录（项目根 项目测试/测试报告/backend）。
      ${project.basedir} = petmate-backend，故上跳一级到仓库根。
    -->
    <petmate.report.dir>${project.basedir}/../项目测试/测试报告/backend</petmate.report.dir>

    <!--
      默认排除 known-issue 分组：这些用例断言的是「期望行为」，
      而被测代码当前存在缺陷，故必然失败。把它们排除在日常构建外，
      避免已知缺陷把 CI 一直染红、掩盖新引入的回归。

      单独查看已知缺陷清单：
        mvnw.cmd test "-Dtest.groups=known-issue" "-Dtest.excludedGroups="
    -->
    <test.groups></test.groups>
    <test.excludedGroups>known-issue</test.excludedGroups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- JWT -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.12.6</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>

    <!-- BCrypt 密码哈希 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- Caffeine 本地缓存（用于 TokenBlacklist 高频读取降压） -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!-- Redis（问诊 AI 回复缓存） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- ===== 测试专用依赖（scope=test，不进生产包） ===== -->

    <!-- Testcontainers：L3 集成测试的真实 MySQL 8.0 实例 -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- WireMock：mock 支付宝网关与智谱 AI 的 HTTP 出站调用 -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>petmate-backend</finalName>

    <!--
      测试代码统一放在仓库根的 tests/backend（非 Maven 默认 src/test）。
      业务代码 src/main 完全不受影响。
    -->
    <testSourceDirectory>${project.basedir}/../tests/backend/java</testSourceDirectory>
    <testResources>
      <testResource>
        <directory>${project.basedir}/../tests/backend/resources</directory>
      </testResource>
    </testResources>

    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- Surefire：执行测试 + XML/TXT 报告输出到 项目测试/测试报告/backend/surefire -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <reportsDirectory>${petmate.report.dir}/surefire</reportsDirectory>
          <!-- 默认激活 test profile，走 tests/backend/resources/application-test.yml -->
          <systemPropertyVariables>
            <spring.profiles.active>test</spring.profiles.active>
          </systemPropertyVariables>
          <!--
            分组过滤。默认排除 known-issue（见 properties 中的说明）。
            用 -Dtest.groups= / -Dtest.excludedGroups= 覆盖，
            例如只跑单元测试：mvnw.cmd test "-Dtest.groups=unit"
          -->
          <groups>${test.groups}</groups>
          <excludedGroups>${test.excludedGroups}</excludedGroups>
          <!-- 无测试类时不报错，方便骨架阶段渐进补充 -->
          <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
        </configuration>
      </plugin>

      <!-- JaCoCo：行覆盖率报告输出到 项目测试/测试报告/backend/coverage -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
            <configuration>
              <!--
                探针数据文件必须留在 target/（纯 ASCII 路径）。
                原因：prepare-agent 把 destfile 拼进 JVM 的 -javaagent 参数，
                该参数在 Windows 上按系统默认编码（GBK）传递，
                路径里的中文「项目测试/测试报告」会变成乱码，
                导致 agent 写不出文件、report 阶段报
                "Skipping JaCoCo execution due to missing execution data file"。
                最终的 HTML 报告仍输出到中文目录（见下方 report），
                那一步由插件用 Java File API 写，不经过 JVM 参数，中文正常。
              -->
              <destFile>${project.build.directory}/jacoco.exec</destFile>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco.exec</dataFile>
              <outputDirectory>${petmate.report.dir}/coverage</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
